#
# ~/.bashrc
#
eval "$(starship init bash)"
# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# Color aliases
alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='[\u@\h \W]\$ '

# User specific environment and startup programs

# Make Electron apps (like VS Code) use Wayland by default
export ELECTRON_OZONE_PLATFORM_HINT=wayland

# Add any other environment variables or aliases here

# Miniforge conda/mamba initialization
eval "$(/opt/miniforge/bin/conda shell.bash hook 2>/dev/null)" || true
eval "$(/opt/miniforge/bin/mamba shell.bash hook 2>/dev/null)" || true


# Launch gnome-control-center with GNOME env without affecting other apps
gnome-control-center() {
    # run the shell builtin `command` to invoke `env` so `env` executes
    # the real `gnome-control-center` (otherwise `env` would try to
    # execute a non-existent external `command` program)
    command env XDG_CURRENT_DESKTOP=GNOME \
        XDG_SESSION_DESKTOP=gnome \
        gnome-control-center "$@"
}

# uv
export PATH="/home/mikkelkp/.local/bin:$PATH"
export PATH="$HOME/.npm-global/bin:$PATH"


# zoxide: smarter cd (`z`, `zi`). The init installs the cd hook that records
# visited directories, so it must be evaluated from the interactive shell.
eval "$(zoxide init bash)"

# broot: `br` shell function (broot cannot cd from a subshell without it).
# Equivalent to `broot --print-shell-function bash`; kept here so chezmoi owns it.
function br {
    local cmd cmd_file code
    cmd_file=$(mktemp)
    if broot --outcmd "$cmd_file" "$@"; then
        cmd=$(<"$cmd_file")
        command rm -f "$cmd_file"
        eval "$cmd"
    else
        code=$?
        command rm -f "$cmd_file"
        return "$code"
    fi
}

# Yazi: leave a current dir
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	command rm -f -- "$tmp"
}

# Machine-local overrides (not tracked by chezmoi).
# Put host-specific exports in ~/.bashrc.local, e.g.:
#   export LUX_ROOT=/run/media/.../LuminaScale
if [ -f "$HOME/.bashrc.local" ]; then
  . "$HOME/.bashrc.local"
fi

# Pi
export PATH="/home/mikkelkp/.pi/agent/bin:$PATH"

# opencode
export PATH=/home/mikkelkp/.opencode/bin:$PATH
