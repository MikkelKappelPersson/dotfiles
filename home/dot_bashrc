#
# ~/.bashrc
#
eval "$(starship init bash)"
# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# Color aliases
alias ls='ls --color=auto'
alias grep='grep --color=auto'
PS1='[\u@\h \W]\$ '

# User specific environment and startup programs
export SCRIPTS="$HOME/.config/waybar"

# Make Electron apps (like VS Code) use Wayland by default
export ELECTRON_OZONE_PLATFORM_HINT=wayland

# Add any other environment variables or aliases here

# Miniforge conda/mamba initialization
eval "$(/opt/miniforge/bin/conda shell.bash hook 2>/dev/null)" || true
eval "$(/opt/miniforge/bin/mamba shell.bash hook 2>/dev/null)" || true


# Launch gnome-control-center with GNOME env without affecting other apps
gnome-control-center() {
    # run the shell builtin `command` to invoke `env` so `env` executes
    # the real `gnome-control-center` (otherwise `env` would try to
    # execute a non-existent external `command` program)
    command env XDG_CURRENT_DESKTOP=GNOME \
        XDG_SESSION_DESKTOP=gnome \
        gnome-control-center "$@"
}
