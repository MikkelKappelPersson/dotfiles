{{- /* Keep pi's own lastChangelogVersion: preserve whatever version is already
     installed locally so `chezmoi status` stays clean across pi upgrades.
     Falls back to the version below on fresh machines. */ -}}
{{- $settingsPath := joinPath .chezmoi.homeDir ".pi/agent/settings.json" -}}
{{- $lastChangelogVersion := "1.2.0" -}}
{{- if stat $settingsPath -}}
{{-   $lastChangelogVersion = output "cat" $settingsPath | fromJson | dig "lastChangelogVersion" $lastChangelogVersion -}}
{{- end -}}
{
  "lastChangelogVersion": {{ $lastChangelogVersion | quote }},
  "theme": "system",
  "defaultProvider": "opencode-zen-free",
  "defaultModel": "minimax-m3.1-flash-free",
  "defaultThinkingLevel": "max",
  "enableSkillCommands": true,
  "defaultTools": ["+codemode"],
  "showHardwareCursor": false,
  "packages": [
    "npm:pi-rewind-hook"
  ],
  "retry": {
    "enabled": true
  },
  "enabledModels": [
    "openrouter/openrouter/free",
    "openrouter/meta/muse-spark-1.3-contributor",
    "vllm-eos-ext/qwen3.8-27b",
    "opencode-zen-free/glm-5.3-flash-free",
    "opencode-zen-free/deepseek-v4.1-flash-free",
    "opencode-zen-free/minimax-m3.1-flash-free"
  ],
  "treeFilterMode": "default",
  "markdown": {
    "mermaid": "streaming"
  },
  "showCacheMissNotices": true,
  "defaultProjectTrust": "always",
  "doubleEscapeAction": "tree",
  "tuiMode": "fullscreen"
}