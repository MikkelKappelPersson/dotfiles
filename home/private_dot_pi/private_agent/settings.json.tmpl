{{- /* Keep pi's own version bookkeeping: preserve whatever versions are already
      installed locally so `chezmoi status` stays clean across pi/extension
      upgrades. Fall back to the values below on fresh machines. */ -}}
{{- $settingsPath := joinPath .chezmoi.homeDir ".pi/agent/settings.json" -}}
{{- $lastChangelogVersion := "1.2.0" -}}
{{- $extensionChangelogVersions := dict -}}
{{- if stat $settingsPath -}}
{{-   $current := output "cat" $settingsPath | fromJson -}}
{{-   $lastChangelogVersion = dig "lastChangelogVersion" $lastChangelogVersion $current -}}
{{-   $extensionChangelogVersions = dig "extensionChangelogVersions" $extensionChangelogVersions $current -}}
{{- end -}}
{
  "lastChangelogVersion": {{ $lastChangelogVersion | quote }},
  "theme": "system",
  "defaultProvider": "meta",
  "defaultModel": "muse-spark-1.3-contributor",
  "defaultThinkingLevel": "max",
  "enableSkillCommands": true,
  "defaultTools": [
    "+codemode"
  ],
  "showHardwareCursor": false,
  "packages": [
    "npm:pi-rewind-hook",
    "../../projects/shepherd"
  ],
  "retry": {
    "enabled": true
  },
  "enabledModels": [
    "openrouter/openrouter/free",
    "vllm-eos-ext/qwen3.8-27b",
    "meta/muse-ember-1.0",
    "meta/muse-spark-1.3-contributor",
    "opencode-zen-free/tidepool-alpha-free"
  ],
  "treeFilterMode": "default",
  "markdown": {
    "mermaid": "streaming"
  },
  "showCacheMissNotices": true,
  "defaultProjectTrust": "always",
  "doubleEscapeAction": "tree",
  "tuiMode": "fullscreen",
  "extensionChangelogVersions": {{ $extensionChangelogVersions | toPrettyJson | trimSuffix "\n" | replace "\n" "\n  " }},
  "hideThinkingBlock": true
}